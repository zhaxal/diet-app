# Copy this file to .env and fill in the values.

# Secret used to sign JWTs. Use a long random string in production.
JWT_SECRET="change-me-to-a-long-random-secret"

# SQLite database location (relative to the prisma/ directory).
DATABASE_URL="file:./dev.db"

# Who may register. The first account can always be created. After that,
# registration is closed unless this is set, and then only people who enter
# this code on the sign-up form can create an account. Leave it empty to keep
# the server to yourself.
INVITE_CODE=""
