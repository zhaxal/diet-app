generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String      @id @default(cuid())
  email         String      @unique
  passwordHash  String
  apiKey        String      @unique @default(cuid())
  dailyCalories Int?
  dailyProtein  Float?
  dailyCarbs    Float?
  dailyFat      Float?
  dailyFiber    Float?
  dailySugar    Float?
  dailySodium   Float?
  weightUnit    String      @default("kg")
  timezone      String      @default("UTC")
  sex           String?
  birthYear     Int?
  heightCm      Float?
  createdAt     DateTime    @default(now())
  entries       FoodEntry[]
  weightLogs    WeightLog[]
  favorites     Favorite[]
  templates     MealTemplate[]
  products      Product[]
  workouts      Workout[]
  exercises     Exercise[]
}

model Product {
  id           String   @id @default(cuid())
  userId       String
  name         String
  brand        String?
  barcode      String?
  basis        String   @default("100g") // "100g" | "100ml"
  calories     Float // per 100 g/ml
  protein      Float    @default(0)
  carbs        Float    @default(0)
  fat          Float    @default(0)
  fiber        Float    @default(0)
  sugar        Float    @default(0)
  sodium       Float    @default(0) // mg
  servingSize  Float? // one serving = N of servingUnit, when the label states it
  servingUnit  String? // g | oz | ml | floz
  source       String   @default("manual") // manual | mcp | openfoodfacts
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, barcode])
  @@index([userId, name])
}

model MealTemplate {
  id        String   @id @default(cuid())
  userId    String
  name      String
  items     String // JSON array of entry items
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WeightLog {
  id        String   @id @default(cuid())
  userId    String
  weight    Float // canonical kilograms, always
  unit      String   @default("kg") // the unit it was entered in: kg | lb
  loggedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loggedAt])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  name      String
  calories  Int
  protein   Float    @default(0)
  carbs     Float    @default(0)
  fat       Float    @default(0)
  fiber     Float    @default(0)
  sugar     Float    @default(0)
  sodium    Float    @default(0)
  mealType  String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model FoodEntry {
  id         String   @id @default(cuid())
  userId     String
  name       String
  calories   Int
  protein    Float    @default(0) // grams
  carbs      Float    @default(0) // grams
  fat        Float    @default(0) // grams
  fiber      Float    @default(0) // grams
  sugar      Float    @default(0) // grams
  sodium     Float    @default(0) // mg
  mealType   String // breakfast | lunch | dinner | snack
  productId  String? // provenance: logged from a saved Product
  quantity   Float? // amount consumed, in `quantityUnit`
  quantityUnit String? // g | oz | ml | floz | serving
  source     String   @default("ui") // which front door wrote this: ui | mcp | import
  consumedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt])
}

model Workout {
  id        String            @id @default(cuid())
  userId    String
  date      DateTime          @default(now())
  title     String            @default("Workout")
  rawNote   String
  notes     String?
  source    String            @default("ui") // ui | mcp
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises WorkoutExercise[]

  @@index([userId, date])
}

model Exercise {
  id          String            @id @default(cuid())
  userId      String
  name        String
  normalized  String
  muscleGroup String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutLogs WorkoutExercise[]

  @@unique([userId, normalized])
  @@index([userId, name])
}

model WorkoutExercise {
  id         String       @id @default(cuid())
  workoutId  String
  exerciseId String
  order      Int          @default(0)
  notes      String?
  workout    Workout      @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise   Exercise     @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  sets       WorkoutSet[]

  @@index([workoutId])
  @@index([exerciseId])
}

model WorkoutSet {
  id                String          @id @default(cuid())
  workoutExerciseId String
  setNumber         Int
  weight            Float           // canonical kilograms
  unit              String          @default("kg") // the unit it was entered in: kg | lb
  reps              Int
  isWarmup          Boolean         @default(false)
  isBodyweight      Boolean         @default(false)
  rpe               Float?
  notes             String?
  createdAt         DateTime        @default(now())
  workoutExercise   WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)

  @@index([workoutExerciseId])
}

