generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String      @id @default(cuid())
  email         String      @unique
  passwordHash  String
  apiKey        String      @unique @default(cuid())
  dailyCalories Int?
  dailyProtein  Float?
  dailyCarbs    Float?
  dailyFat      Float?
  dailyFiber    Float?
  dailySugar    Float?
  dailySodium   Float?
  weightUnit    String      @default("kg")
  timezone      String      @default("UTC")
  sex           String?
  birthYear     Int?
  heightCm      Float?
  createdAt     DateTime    @default(now())
  entries       FoodEntry[]
  weightLogs    WeightLog[]
  favorites     Favorite[]
  templates     MealTemplate[]
  products      Product[]
}

model Product {
  id           String   @id @default(cuid())
  userId       String
  name         String
  brand        String?
  barcode      String?
  basis        String   @default("100g") // "100g" | "100ml"
  calories     Float // per 100 g/ml
  protein      Float    @default(0)
  carbs        Float    @default(0)
  fat          Float    @default(0)
  fiber        Float    @default(0)
  sugar        Float    @default(0)
  sodium       Float    @default(0) // mg
  servingGrams Float? // one serving = N grams, when the label states it
  source       String   @default("manual") // manual | mcp | openfoodfacts
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, barcode])
  @@index([userId, name])
}

model MealTemplate {
  id        String   @id @default(cuid())
  userId    String
  name      String
  items     String // JSON array of entry items
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WeightLog {
  id        String   @id @default(cuid())
  userId    String
  weight    Float
  loggedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loggedAt])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  name      String
  calories  Int
  protein   Float    @default(0)
  carbs     Float    @default(0)
  fat       Float    @default(0)
  fiber     Float    @default(0)
  sugar     Float    @default(0)
  sodium    Float    @default(0)
  mealType  String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model FoodEntry {
  id         String   @id @default(cuid())
  userId     String
  name       String
  calories   Int
  protein    Float    @default(0) // grams
  carbs      Float    @default(0) // grams
  fat        Float    @default(0) // grams
  fiber      Float    @default(0) // grams
  sugar      Float    @default(0) // grams
  sodium     Float    @default(0) // mg
  mealType   String // breakfast | lunch | dinner | snack
  productId  String? // provenance: logged from a saved Product
  quantityGrams Float? // grams consumed, when logged from a Product
  consumedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt])
}
